# 复制成 .env 再填。不要提交 .env，不要把这里的值发到 Telegram。
# 每一项从哪来，见 docs/配置.md

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 至少 8 位。只放在本机，练习页和技能用它登录。
PRACTICE_PASSWORD=

# 现在走 OpenAI 兼容接口。以后换 DeepSeek 只改这三项。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek 示例（先不要删掉上面的默认值，换的时候改成下面这样）：
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

PRACTICE_BASE_URL=http://127.0.0.1:8765
PRACTICE_DRIVER=http
CHROME_CDP_URL=http://127.0.0.1:9222
